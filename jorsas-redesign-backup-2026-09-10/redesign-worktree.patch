+/* ══ Landing page (editorial redesign) ══════════════════════════════ */
+
+/* Red text selection, brand-wide signature */
+::selection {
+  background: var(--color-primary);
+  color: #ffffff;
+}
+
+/* Scroll-reveal: sections start hidden and settle into place when the
+   Reveal wrapper (IntersectionObserver) stamps .is-visible. Variants:
+   fade (rise up), left / right (side slides for split layouts), scale
+   (images settling from a slight zoom). */
+.reveal-fade,
+.reveal-left,
+.reveal-right,
+.reveal-scale {
+  opacity: 0;
+  transition:
+    opacity 800ms cubic-bezier(0.22, 1, 0.36, 1),
+    transform 800ms cubic-bezier(0.22, 1, 0.36, 1);
+  will-change: opacity, transform;
+}
+.reveal-fade { transform: translateY(32px); }
+.reveal-left { transform: translateX(-48px); }
+.reveal-right { transform: translateX(48px); }
+.reveal-scale { transform: scale(1.08); }
+.reveal-fade.is-visible,
+.reveal-left.is-visible,
+.reveal-right.is-visible,
+.reveal-scale.is-visible {
+  opacity: 1;
+  transform: none;
+}
+
+/* Hero dot pattern — fine dots fading out from the upper right, quieter
+   and warmer than the old grid lines. */
+.hero-dots {
+  position: relative;
+  isolation: isolate;
+}
+.hero-dots::before {
+  content: "";
+  position: absolute;
+  inset: 0;
+  z-index: -1;
+  pointer-events: none;
+  background-image: radial-gradient(rgba(255, 255, 255, 0.16) 1px, transparent 1.4px);
+  background-size: 26px 26px;
+  mask-image: radial-gradient(ellipse 85% 65% at 72% 12%, black 0%, transparent 72%);
+  -webkit-mask-image: radial-gradient(ellipse 85% 65% at 72% 12%, black 0%, transparent 72%);
+}
+html.light .hero-dots::before {
+  background-image: radial-gradient(rgba(15, 23, 42, 0.2) 1px, transparent 1.4px);
+}
+
+/* Desktop nav links: red underline sweeps in from the left on hover;
+   active links keep it. */
+.nav-link {
+  position: relative;
+}
+.nav-link::after {
+  content: "";
+  position: absolute;
+  left: 0;
+  right: 100%;
+  bottom: -6px;
+  height: 1px;
+  background: var(--color-primary);
+  transition: right 300ms ease;
+}
+.nav-link:hover::after,
+.nav-link.nav-link-active::after {
+  right: 0;
+}
+
+@media (prefers-reduced-motion: reduce) {
+  .reveal-fade,
+  .reveal-left,
+  .reveal-right,
+  .reveal-scale {
+    opacity: 1;
+    transform: none;
+    transition: none;
+  }
+}
