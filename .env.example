APP_NAME="Your App"
# Disable debug mode by changing APP_DEBUG=false when your site is ready for live.
APP_DEBUG=false
APP_ENV=production
# Must change APP_URL to your website URL. Example: APP_URL=http://your-domain.com
APP_URL=http://localhost
APP_KEY=base64:aupx1RSuyw8STqR4i3nxG5Xks5OGwbZN5xelUG0NVPE=
LOG_CHANNEL=daily

# Real-time chat delivery. Set to "pusher" and fill the PUSHER_* block below for
# instant push; leave as "null" and chat falls back to interval polling (still
# works, just not instant). NOTE: on Laravel 11 the key is BROADCAST_CONNECTION —
# the old BROADCAST_DRIVER name is ignored.
BROADCAST_CONNECTION=null

# Pusher Channels credentials (dashboard.pusher.com -> your app -> App Keys).
# Needed only when BROADCAST_CONNECTION=pusher. APP_SECRET is server-side ONLY —
# never expose it to the frontend. After editing these on the server run
# `php artisan config:clear`, or a cached config keeps broadcasting off.
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
# Keep true in production; set false only as a workaround for shared hosts whose
# outdated CA bundle breaks TLS verification to Pusher.
PUSHER_SSL_VERIFY=true
# The Next.js frontend needs its OWN build-time copies (in jorsas-tech-v2 env):
# NEXT_PUBLIC_PUSHER_KEY (= PUSHER_APP_KEY) and NEXT_PUBLIC_PUSHER_CLUSTER.

CACHE_STORE=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Change to your database credentials
DB_CONNECTION=mysql
# If you use Laravel Sail, just change DB_HOST to DB_HOST=mysql
# On some hosting DB_HOST can be localhost instead of 127.0.0.1
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE="laravel"
DB_USERNAME="root"
DB_PASSWORD="your_db_password"
DB_STRICT=false

# You should change this value to hide your admin URL (DON'T use special characters). Example: ADMIN_DIR=hello-admin then your admin URL will be
# http://your-domain.com/hello-admin
ADMIN_DIR=admin

CMS_ENABLE_INSTALLER=true

# Paystack payment gateway (test keys)
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxx
FRONTEND_URL=http://127.0.0.1:3000

# Live classes — 8x8 JaaS (managed Jitsi). Create an app at jaas.8x8.vc:
#  - JITSI_APP_ID       = the app's "magic cookie" (vpaas-magic-cookie-...)
#  - JITSI_API_KEY_ID   = the API key's kid (used as the JWT `kid` header)
#  - JITSI_PRIVATE_KEY  = that key's RS256 PEM, base64-encoded on ONE line so it
#                         survives dotenv (a raw multi-line PEM breaks parsing).
# Leave these blank to disable live classes gracefully (the join endpoints return
# a clean 503 "Live classes are not configured yet." instead of erroring).
JITSI_APP_ID=vpaas-magic-cookie-c8094b827dd741ef8a5fbea819cde5c1
JITSI_API_KEY_ID=vpaas-magic-cookie-c8094b827dd741ef8a5fbea819cde5c1/25a199
JITSI_PRIVATE_KEY=-----BEGIN PRIVATE KEY----------END PRIVATE KEY-----

JITSI_DOMAIN=8x8.vc

# AI training materials — Gamma Generate API (developers.gamma.app). Lets Pro+
# academy owners generate a document/deck from a prompt, then save the link into
# a course or module. Requires a Gamma Pro/Ultra/Teams/Business subscription;
# create the key at Gamma → Settings → API Keys (it looks like `sk-gamma-...`).
# Leave GAMMA_API_KEY blank to disable the feature gracefully — the endpoints
# return a clean 503 ("not available right now") instead of erroring, and the
# sidebar "Create with AI" entry still prompts non-Pro academies to upgrade.
# GAMMA_API_BASE only changes if Gamma bumps its API version segment.
GAMMA_API_KEY=
GAMMA_API_BASE=https://public-api.gamma.app/v1.0

# Pre-recorded video hosting — Bunny Stream (bunny.net → Stream). Lets Basic+
# academies upload lesson videos + video materials that are stored ENTIRELY on
# Bunny (the browser uploads straight to Bunny; the bytes never touch our server
# or DB — we keep only the video id, a thumbnail URL and the player embed URL).
# Create a Stream video library at bunny.net, then:
#  - BUNNY_STREAM_LIBRARY_ID   = the library's numeric id
#  - BUNNY_STREAM_API_KEY      = that library's API key (a SECRET — never commit)
#  - BUNNY_STREAM_CDN_HOSTNAME = the library's pull-zone host, e.g.
#                                vz-xxxxxxxx-xxx.b-cdn.net (no scheme) — builds
#                                the thumbnail + HLS URLs.
#  - BUNNY_STREAM_COLLECTION_ID = optional; files uploads under one collection.
# Leave BUNNY_STREAM_LIBRARY_ID / BUNNY_STREAM_API_KEY blank to disable uploads
# gracefully — the endpoints return a clean 503 ("not available right now").
BUNNY_STREAM_LIBRARY_ID=
BUNNY_STREAM_API_KEY=
BUNNY_STREAM_CDN_HOSTNAME=
BUNNY_STREAM_COLLECTION_ID=


# If your site has SSL issues, you can force the schema and root URL by uncommenting the following lines, change domain to your domain.
# Docs: https://docs.botble.com/cms/ssl.html
#FORCE_SCHEMA=https
#FORCE_ROOT_URL=https://your-domain.com
FRONTEND_API_ENABLED=false
# Enables the public course intake + per-institute storefront self-registration.
# The storefront IS the SaaS product, so this must be on for new deployments —
# with it off, institute pages render but their register/pay flow returns 404.
TRAINING_FEATURE_ENABLED=true
TRAINING_EMAIL_ENABLED=false
TRAINING_ADMIN_EMAIL=obasesamgospel@gmail.com
# Public URL of the Next.js frontend. Every link in outgoing email (staff/student
# invites, password resets, owner setup, payment callbacks) is built from this.
# In PRODUCTION set it to your live public site, e.g. https://jorsastech.com —
# otherwise every emailed link points at localhost and is dead for the recipient.
# Read via config('saas.frontend_url'), so it survives `php artisan config:cache`.
LMS_BASE_URL=http://127.0.0.1:3000
LMS_FEATURE_ENABLED=false

# Notification emails: every in-app notification (and every platform announcement)
# is also emailed to the recipient by the scheduled `lms:send-notification-emails`
# sweep (requires cron running `php artisan schedule:run`). Master off-switch —
# set to false to keep in-app notifications but stop emailing them (e.g. until
# MAIL_* is verified in production):
NOTIFICATION_EMAILS_ENABLED=true
# Comma-separated notification `type`s created in-app but NOT emailed. Chat
# @mentions are high-volume/real-time, so they are excluded by default. Clear
# this (or drop 'mention') to email those too:
NOTIFICATION_EMAIL_EXCLUDE_TYPES=mention
# How many emails one sweep run sends per recipient table (keeps a single cron
# tick bounded on sync mail / shared hosting; the backlog drains next ticks):
NOTIFICATION_EMAIL_BATCH=120
# Give up emailing a notification after this many failed attempts:
NOTIFICATION_EMAIL_MAX_ATTEMPTS=3
